# ─── Cloud Life Sales Army — environment ───────────────────────────────
# Copy to .env.local (dev) or set in your secret manager (production).
# NEVER commit real values. All secrets are read server-side only.

NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://salesarmy:salesarmy@localhost:5432/salesarmy
# Test database (must end in _test; tests drop and recreate its schema)
TEST_DATABASE_URL=postgres://salesarmy:salesarmy@localhost:5432/salesarmy_test

# Session signing key — 32+ random bytes, e.g. `openssl rand -hex 32`. REQUIRED in production.
SESSION_SECRET=
# Encryption key for secrets entered in the Setup wizard (32 bytes hex). Strongly recommended.
SECRETS_ENCRYPTION_KEY=
# One-time first-admin login for the Setup wizard (≥24 chars). Remove after an Entra admin has signed in.
SETUP_TOKEN=

# ── Microsoft Entra ID (OIDC sign-in) ──
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional: map Entra security groups to roles (or use app roles SalesArmy.Admin / SalesArmy.Analyst)
ENTRA_ADMIN_GROUP_ID=
ENTRA_ANALYST_GROUP_ID=
# Comma-separated bootstrap admins (always admin on sign-in)
INITIAL_ADMIN_EMAILS=
# Local-only login form (ignored when NODE_ENV=production)
AUTH_DEV_LOGIN=false

# ── Integration keys: preferably set in the Setup wizard (stored encrypted). Env values override. ──
# ── AI execution ──
# Default: Claude Subscription Mode (wizard step 2) — NO API key needed. AI work runs in Claude Code scheduled tasks.
# Only for the optional Paid API Mode (requires explicit approval in the wizard):
ANTHROPIC_API_KEY=
# Optional: scheduled-task API trigger token (prefer the wizard, stored encrypted)
ROUTINE_FIRE_TOKEN=
# Optional alternative to the wizard-generated bridge token: SHA-256 hex hash of the token
SALES_ARMY_BRIDGE_TOKEN_HASH=

# ── Claude Code session side (set in the Claude Code environment, NOT here in production) ──
# SALES_ARMY_URL=https://sales.cloudlife.example        (environment variable)
# Bridge token: configure as a NETWORK SECRET for that host (Authorization: Bearer …), never as a variable.
# Local development only: SALES_ARMY_BRIDGE_TOKEN=…  or leave SALES_ARMY_URL empty to use the in-process bridge.
# Behind an HTTPS egress proxy: NODE_USE_ENV_PROXY=1 (fetch honours HTTPS_PROXY)

# ── Research providers (optional; system degrades gracefully) ──
FIRECRAWL_API_KEY=
BRAVE_SEARCH_API_KEY=
# KvK API (licensed register access; paid — approve in Settings → Budget first)
KVK_API_KEY=
DOH_RESOLVER_URL=https://cloudflare-dns.com/dns-query
RESEARCH_USER_AGENT=CloudLifeSalesArmyResearchBot/1.0 (+https://www.cloudlife.nl)

# ── Worker (optional in Claude Subscription Mode) ──
WORKER_CONCURRENCY=4
